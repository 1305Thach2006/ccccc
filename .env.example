# ==========================================
# CẤU HÌNH MÔI TRƯỜNG MẪU (AI CAREER COACH)
# Sao chép file này thành .env nếu muốn tùy chỉnh:
# cp .env.example .env
# ==========================================

# 1. Cấu hình PostgreSQL Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword123
POSTGRES_DB=career_coach
POSTGRES_PORT=5433

# 2. Cấu hình Backend FastAPI
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg2://admin:secretpassword123@postgres_db:5432/career_coach

# 3. Cấu hình AI (Ollama - Qwen 3.5:4b)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b

# 4. Cấu hình Frontend Web Server
FRONTEND_PORT=5050
