# ==========================================
# CẤU HÌNH MÔI TRƯỜNG MẪU (AI CAREER COACH)
# Không bắt buộc. Chỉ sao chép file này thành .env nếu muốn đổi cổng hoặc mật khẩu:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
# ==========================================

# 1. PostgreSQL Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword123
POSTGRES_DB=career_coach
POSTGRES_PORT=5433

# 2. Backend FastAPI
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg2://admin:secretpassword123@postgres_db:5432/career_coach

# 3. AI (Ollama + Qwen 3.5:4b)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_DOCKER_PORT=11435

# 4. Frontend Web Server
FRONTEND_PORT=5050
